# ============================================================
# RecoverAI — Local environment configuration
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is gitignored via .env.*
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Find at: https://supabase.com/dashboard/project/<ref>/settings/api

# Browser client (VITE_ prefix = exposed to frontend bundle)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server client (NOT exposed to browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Server admin client — bypasses RLS. Server-only. Never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── PayPal Sandbox ────────────────────────────────────────────
# 1. Go to https://developer.paypal.com/dashboard/
# 2. Log in or create a free developer account
# 3. Click "Apps & Credentials" → "Create App"
# 4. Select "Sandbox" environment
# 5. Copy the Client ID and Secret below

# Exposed to server only — never to the browser
PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret

# Sandbox base URL — change to https://api-m.paypal.com for live (DO NOT use live for demos)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Webhook ID — from PayPal dashboard → Your App → Webhooks
# Required for signature verification. Leave blank during local dev (events still recorded).
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# ── Optional AI gateway ───────────────────────────────────────
# If not set, the deterministic rule-based fallback is used automatically.
LOVABLE_API_KEY=your-lovable-api-key-here

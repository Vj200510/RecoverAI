# ============================================================
# RecoverAI — Environment Variables
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local — it is excluded by .gitignore.
# ============================================================

# ── Supabase ──────────────────────────────────────────────────
# Dashboard: https://supabase.com/dashboard/project/<ref>/settings/api

# Browser client (VITE_ prefix = included in browser bundle)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server client (never reaches the browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key — bypasses RLS. Server-only. Never expose to browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── PayPal Sandbox ────────────────────────────────────────────
# 1. Go to https://developer.paypal.com/dashboard/
# 2. Sign in → Apps & Credentials → Create App (Sandbox)
# 3. Copy Client ID and Secret below
# 4. For webhooks: Apps & Credentials → Webhooks → Add endpoint

PAYPAL_CLIENT_ID=your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret

# Keep this as sandbox for all development and demo work.
# NEVER change to https://api-m.paypal.com without explicit authorization.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Webhook ID from PayPal dashboard → your app → Webhooks
# Optional for local development. Required for production webhook verification.
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# ── Optional AI gateway ───────────────────────────────────────
# If not set, the deterministic rule-based fallback is used automatically.
# LOVABLE_API_KEY=your-lovable-api-key-here
